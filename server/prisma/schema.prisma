generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  inventory    Inventory?
  monsters     Monster[]
  entries      TournamentEntry[]
}

model Inventory {
  userId String @id
  meat   Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonsterSpecies {
  id             String   @id
  name           String
  rarity         String
  baseStatsJson  Json
  growthJson     Json
  renderSeed     String
  tameDifficulty Float
  monsters       Monster[]
}

model Monster {
  instanceId          String   @id @default(cuid())
  ownerId             String
  speciesId           String
  level               Int      @default(1)
  exp                 Int      @default(0)
  currentHp           Int
  allocatedStatsJson  Json
  unspentStatPoints   Int      @default(0)
  parentAId           String?
  parentBId           String?
  createdAt           DateTime @default(now())
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species             MonsterSpecies @relation(fields: [speciesId], references: [id])
  tournamentEntries   TournamentEntry[]
}

model Area {
  id                 String @id
  name               String
  biomeTag           String
  levelRangeMin      Int
  levelRangeMax      Int
  encounterTableJson Json
}

model Tournament {
  id        String   @id @default(cuid())
  status    String
  createdAt DateTime @default(now())
  startedAt DateTime?
  endedAt   DateTime?
  entries   TournamentEntry[]
}

model TournamentEntry {
  id               String @id @default(cuid())
  tournamentId     String
  userId           String
  monsterInstanceId String
  eliminatedRound  Int?
  result           String?
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  monster    Monster    @relation(fields: [monsterInstanceId], references: [instanceId], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  label     String
  createdAt DateTime @default(now())
}
